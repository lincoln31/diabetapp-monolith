# Configuración del servidor
NODE_ENV=development
PORT=3000

# JWT Secret: genera uno con `npm run generate-secret` (mínimo 32 caracteres)
JWT_SECRET=reemplaza_esto_por_un_secreto_generado_de_32_caracteres_o_mas

# Base de datos (coincide con docker-compose.yml: puerto 5433)
DATABASE_URL="postgresql://user:password@localhost:5433/diabetapp_dev?schema=public"

# Sesión (fase 2)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Límites de peticiones
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REFRESH_MAX=30

# Proxies de confianza: false en local; 1 detrás de Render/Railway/Nginx
TRUST_PROXY=false
