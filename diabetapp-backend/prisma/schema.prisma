generator client {
  provider = "prisma-client-js"
 
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  
}


// prisma/schema.prisma
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String
  firstName       String?   
  lastName        String?
  phone           String?   // Teléfono de contacto (opcional)
  
  // Perfil específico de diabetes (según RF001)
  typeOfDiabetes  DiabetesType?
  diagnosedAt     DateTime? // Fecha del diagnóstico
  yearsWithDiabetes Int?    // Calculado o manual, importante para personalización
  
  // Metas y configuración (según RF004)
  targetHba1c     Float?    // Meta de HbA1c, ej: 6.5
  targetGlucoseMin Int?     @default(80)  // Rango glucémico mínimo (mg/dL)
  targetGlucoseMax Int?     @default(180) // Rango glucémico máximo (mg/dL)
  
  // Configuración personal (según RNF002 - Usabilidad)
  birthDate       DateTime? // Para personalizar contenido educativo por edad
  weight          Float?    // Para calculadoras y recomendaciones
  height          Float?    // Para calculadoras de IMC
  activityLevel   ActivityLevel?
  
  // Configuración de medicamentos (según RF005)
  currentMedications String? // JSON o texto simple por ahora
  insulinType     InsulinType?
  
  // Preferencias de notificaciones (según RF001)
  notificationPreferences Json? // Estructura flexible para diferentes tipos
  reminderTimes   Json?     // Horarios personalizados para recordatorios
  
  // Configuración de metas diarias (según RF004)
  dailyGlucoseChecks Int?   @default(4) // Meta de glucometrías por día
  exerciseGoalMinutes Int?  @default(30) // Meta de ejercicio diario
  
  // Metadata importante para análisis (según RNF007)
  timezone        String?   @default("America/Bogota") // Para timestamps correctos
  language        String?   @default("es") // Para localización
  onboardingCompleted Boolean @default(false) // Control del setup inicial
  isActive        Boolean   @default(true)  // Para soft delete
  
  // Compliance y privacidad (según RNF003)
  dataConsentAt   DateTime? // Cuándo aceptó términos de datos
  lastLoginAt     DateTime? // Para métricas de engagement
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relaciones futuras (preparación para Fase 2-3)
   glucoseReadings GlucoseReading[]
  refreshTokens   RefreshToken[]
  medications     Medication[]
  medicationIntakes MedicationIntake[]
  // achievements    Achievement[]
  // dailyGoals      DailyGoal[]

  
  @@map("users") 
}

model GlucoseReading {
  id        String    @id @default(cuid())
  value     Int       // El valor en mg/dL, ej: 110

  // Contexto del registro (según RF002)
  timestamp DateTime  // Fecha y hora exactas del registro, enviadas desde el móvil
  momentOfDay MomentOfDay @default(OTHER)
  notes     String?   // Notas opcionales del usuario, ej: "Comí pizza"

  // Relación con el usuario (¡LA PARTE MÁS IMPORTANTE!)
  userId    String    // Clave foránea que apunta al ID del usuario
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Metadata
  createdAt DateTime  @default(now())

  @@index([userId, timestamp]) // Consulta principal: historial del usuario por fecha
  @@map("glucose_readings") // Nombre explícito para la tabla
}
/// Token de renovación de sesión (spec fase 2, RF-2.2): se guarda solo su hash.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash    String    @unique // SHA-256 del token; el valor nunca se guarda
  familyId     String    // Cadena de sesión: un login = una familia de tokens
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   // Token que lo sustituyó al rotar
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Medicamento del paciente (spec fase 11, D-11.1). `active=false` = archivado: conserva el historial de tomas.
model Medication {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name           String
  dosage         String   // texto libre: "500 mg", "10 unidades"
  scheduledTimes String[] // horas locales "HH:mm", ordenadas
  notes          String?
  active         Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  intakes        MedicationIntake[]

  @@index([userId, active])
  @@map("medications")
}

/// Una toma registrada de un medicamento (spec fase 11, D-11.1).
model MedicationIntake {
  id           String     @id @default(cuid())
  medicationId String
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  userId       String     // duplicado a propósito: filtra por usuario sin JOIN
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  takenAt      DateTime
  createdAt    DateTime   @default(now())

  @@index([userId, takenAt])
  @@index([medicationId])
  @@map("medication_intakes")
}

// --- Enums (fase 1, RF-1.18): la base de datos rechaza valores fuera de estas listas ---

enum DiabetesType {
  TYPE_1
  TYPE_2
  GESTATIONAL
  PREDIABETES
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
}

enum InsulinType {
  RAPID
  LONG_ACTING
  MIXED
  NONE
}

enum MomentOfDay {
  BEFORE_BREAKFAST
  AFTER_BREAKFAST
  BEFORE_LUNCH
  AFTER_LUNCH
  BEFORE_DINNER
  AFTER_DINNER
  BEFORE_SLEEP
  OTHER
}
