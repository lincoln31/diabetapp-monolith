# Variables solo para tests (locales y de CI). No contienen secretos reales.
NODE_ENV=test
PORT=3100
DATABASE_URL="postgresql://user:password@localhost:5433/diabetapp_test"
JWT_SECRET=secreto_de_pruebas_de_al_menos_32_caracteres_1234
# bcrypt con coste bajo para que los tests no tarden
BCRYPT_ROUNDS=4
# El límite de login se deja en su valor real para poder probarlo: cuenta solo
# intentos fallidos por IP+correo, y cada test usa un correo distinto
RATE_LIMIT_LOGIN_MAX=5
# Registro y refresh con límites altos: muchos tests registran usuarios

RATE_LIMIT_REGISTER_MAX=1000
RATE_LIMIT_REFRESH_MAX=1000
