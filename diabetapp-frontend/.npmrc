# Expo fija sus propias versiones de React/React Native. Algunos paquetes declaran
# peers opcionales para plataformas que no usamos (p. ej. react-native-windows en
# datetimepicker) con rangos que chocan con esas versiones y npm los trata como
# error. La compatibilidad real la comprueba `npx expo-doctor`.
legacy-peer-deps=true
